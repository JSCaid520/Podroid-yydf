#!/bin/sh
# Podroid container backup — export containers/images to tar archives.
#
# The guest ships two engines (rootless podman and dockerd). Both are supported
# here: `all` exports the containers of every installed engine, `list` shows
# them per engine, and `export`/`save` operate on whichever engine actually has
# the container/image. Archive names carry the engine, so a container name that
# exists in both does not overwrite the other's backup.
#
# With Downloads sharing: /mnt/downloads/Podroid/backups/
# Otherwise: /var/backups/podroid/
set -eu

ENGINES="podman docker"

backup_root() {
	# PODROID_BACKUP_ROOT overrides the target directory (used by the project's
	# own tests; harmless to leave in place for scripted runs).
	if [ -n "${PODROID_BACKUP_ROOT:-}" ]; then
		printf '%s\n' "$PODROID_BACKUP_ROOT"
	elif mountpoint -q /mnt/downloads 2>/dev/null; then
		printf '%s\n' "/mnt/downloads/Podroid/backups"
	else
		printf '%s\n' "/var/backups/podroid"
	fi
}

# Both CLIs print a notification id on success (podroid-hostd answers with the
# posted id); redirect it, or the id looks like a stray number in the terminal.
notify_ok() {
	body="$1"
	if command -v podroid-notify >/dev/null 2>&1; then
		podroid-notify --title "Podroid backup" "$body" >/dev/null 2>&1 || true
	fi
}

notify_err() {
	body="$1"
	if command -v podroid-notify >/dev/null 2>&1; then
		podroid-notify --priority high --title "Podroid backup failed" "$body" >/dev/null 2>&1 || true
	fi
}

usage() {
	cat <<'EOF'
usage:
  podroid-backup list
  podroid-backup export <container> [output.tar]
  podroid-backup save <image> [output.tar]
  podroid-backup all

Both podman and docker are supported; an engine that is not installed is
skipped. Archives are written to /mnt/downloads/Podroid/backups when Downloads
sharing is enabled, otherwise to /var/backups/podroid.

Examples:
  podroid-backup list
  podroid-backup export my-nginx
  podroid-backup save docker.io/library/nginx:latest
  podroid-backup all
EOF
}

engine_installed() {
	command -v "$1" >/dev/null 2>&1
}

# Space-separated list of the engines actually present in this image.
installed_engines() {
	for e in $ENGINES; do
		engine_installed "$e" && printf '%s ' "$e"
	done
}

engine_ids() {
	case "$1" in
		podman) podman ps -aq 2>/dev/null ;;
		docker) docker ps -aq 2>/dev/null ;;
	esac
}

engine_name_of() {
	case "$1" in
		podman) podman inspect -f '{{.Name}}' "$2" 2>/dev/null | sed 's#^/##' ;;
		docker) docker inspect -f '{{.Name}}' "$2" 2>/dev/null | sed 's#^/##' ;;
	esac
}

engine_has_container() {
	case "$1" in
		podman) podman ps -a --format '{{.Names}}' 2>/dev/null | grep -Fxq -e "$2" ;;
		docker) docker ps -a --format '{{.Names}}' 2>/dev/null | grep -Fxq -e "$2" ;;
	esac
}

engine_has_image() {
	case "$1" in
		podman) podman image exists "$2" >/dev/null 2>&1 ;;
		docker) docker image inspect "$2" >/dev/null 2>&1 ;;
	esac
}

engine_export() {
	case "$1" in
		podman) podman export "$2" -o "$3" ;;
		docker) docker export "$2" -o "$3" ;;
	esac
}

engine_save() {
	case "$1" in
		podman) podman save "$2" -o "$3" ;;
		docker) docker save "$2" -o "$3" ;;
	esac
}

cmd_list() {
	total=0
	for e in $(installed_engines); do
		printf '== %s ==\n' "$e"
		case "$e" in
			podman) podman ps -a --format 'table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Image}}' 2>/dev/null || true ;;
			docker) docker ps -a --format 'table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Image}}' 2>/dev/null || true ;;
		esac
		n="$(engine_ids "$e" | wc -l | tr -d ' ')"
		printf '\n'
		total=$((total + n))
	done
	if [ "$total" -eq 0 ]; then
		echo "no containers on any installed engine"
	fi
}

safe_name() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

cmd_export() {
	name="$1"
	out="${2:-}"
	root="$(backup_root)"
	mkdir -p "$root"
	hit=0
	for e in $(installed_engines); do
		if ! engine_has_container "$e" "$name"; then
			continue
		fi
		hit=1
		if [ -n "$out" ]; then
			# An explicit target holds one archive, so the first engine that has
			# this container wins.
			target="$out"
		else
			target="$root/$(safe_name "$name")-$e-$(date +%Y%m%d-%H%M%S).tar"
		fi
		if engine_export "$e" "$name" "$target"; then
			echo "exported $name ($e) -> $target"
			notify_ok "Exported container $name ($e)"
		else
			notify_err "export failed for $name ($e)"
			return 1
		fi
		if [ -n "$out" ]; then
			break
		fi
	done
	if [ "$hit" -eq 0 ]; then
		echo "no such container on any installed engine: $name" >&2
		return 1
	fi
	return 0
}

cmd_save() {
	ref="$1"
	out="${2:-}"
	root="$(backup_root)"
	mkdir -p "$root"
	hit=0
	for e in $(installed_engines); do
		if ! engine_has_image "$e" "$ref"; then
			continue
		fi
		hit=1
		if [ -n "$out" ]; then
			target="$out"
		else
			target="$root/$(safe_name "$ref")-$e-$(date +%Y%m%d-%H%M%S).tar"
		fi
		if engine_save "$e" "$ref" "$target"; then
			echo "saved $ref ($e) -> $target"
			notify_ok "Saved image $ref ($e)"
		else
			notify_err "save failed for $ref ($e)"
			return 1
		fi
		if [ -n "$out" ]; then
			break
		fi
	done
	if [ "$hit" -eq 0 ]; then
		echo "no such image on any installed engine: $ref" >&2
		return 1
	fi
	return 0
}

cmd_all() {
	root="$(backup_root)"
	mkdir -p "$root"
	ok=0
	fail=0
	for e in $(installed_engines); do
		# `|| true`: a CLI that exists but fails (daemon down, rootless
		# permission trouble) must read as "no containers", not abort the whole
		# run under `set -e`.
		ids="$(engine_ids "$e" || true)"
		if [ -z "$ids" ]; then
			echo "no containers on $e"
			continue
		fi
		for id in $ids; do
			name="$(engine_name_of "$e" "$id")"
			[ -n "$name" ] || name="$id"
			stamp="$(date +%Y%m%d-%H%M%S)"
			target="$root/$(safe_name "$name")-$e-$stamp.tar"
			if engine_export "$e" "$name" "$target" 2>/dev/null; then
				ok=$((ok + 1))
				echo "exported $name ($e) -> $target"
			else
				fail=$((fail + 1))
				echo "failed $name ($e)" >&2
			fi
		done
	done
	if [ "$ok" -eq 0 ] && [ "$fail" -eq 0 ]; then
		echo "nothing to back up: no containers were found ($(installed_engines))" >&2
		return 0
	fi
	notify_ok "Backed up $ok container(s)${fail:+, $fail failed}"
	echo "done: $ok ok, $fail failed"
}

main() {
	if [ -z "$(installed_engines)" ]; then
		echo "neither podman nor docker is installed" >&2
		return 1
	fi

	case "${1:-}" in
		list)   cmd_list ;;
		export)
			[ $# -ge 2 ] || { usage; return 2; }
			cmd_export "$2" "${3:-}"
			;;
		save)
			[ $# -ge 2 ] || { usage; return 2; }
			cmd_save "$2" "${3:-}"
			;;
		all)    cmd_all ;;
		-h|--help|help|"") usage ;;
		*) echo "unknown command: $1" >&2; usage; return 2 ;;
	esac
}

main "$@"
